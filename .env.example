# Copy this file to .env and fill in strong values before deploying.
# .env is git-ignored and never committed.

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=connecting_db

# Keycloak
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Admin email — this account is never auto-deleted by the inactivity cleanup
ADMIN_EMAIL=your@email.com

# Admin user id — the Keycloak `sub` (users.id) of the real admin account. Every
# new user automatically gets a direct chat with this account (bug reports/contact),
# same auto-creation pattern as the Arno bot chat but pointing at a real human who
# replies manually. Leave empty to disable the feature entirely.
#
# Auto-populated: if ADMIN_USER_PASSWORD (below) is set, deploy-local.sh/deploy-prod.sh
# create this account in the wacchat Keycloak realm on every run (idempotent — skipped
# if it already exists) and write the resulting id here automatically, so no manual
# bootstrap step is needed. Leave ADMIN_USER_ID itself empty and let the script fill it in.
ADMIN_USER_ID=

# Password for the seeded admin account (username/email = ADMIN_EMAIL above). Leave
# empty to skip admin-account seeding entirely (ADMIN_USER_ID then stays empty and the
# admin-chat feature stays disabled, same as before).
ADMIN_USER_PASSWORD=

# Mail — Resend SMTP (smtp.resend.com:465), used for welcome emails and
# Keycloak verification/reset emails. Leave empty to disable mail sending.
RESEND_API_KEY=
MAIL_FROM=
MAIL_USERNAME=
MAIL_PASSWORD=

# Cloudflare R2 (avatar storage) — create a bucket + an S3-compatible API token
# with Object Read & Write permissions scoped to that bucket. Enable the bucket's
# "Public Development URL" (or bind a custom domain) for R2_PUBLIC_BASE_URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# file-service — shared secret the backend sends on every call so file-service
# can reject requests that don't come from the backend. Generate with:
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
FILE_SERVICE_INTERNAL_API_KEY=

# RabbitMQ — broker for notification events (backend -> notification-service) and the
# STOMP relay notification-service uses instead of an in-memory broker, so WebSocket
# push notifications work correctly across multiple notification-service instances.
# RABBITMQ_USER/PASSWORD is the admin account (management UI + fallback for the vars below).
RABBITMQ_USER=wacchat
RABBITMQ_PASSWORD=wacchat

# Optional: separate least-privilege credentials per consumer instead of sharing the admin
# account above. Backend gets publish-only rights on the notification exchange/queue (no
# read/consume); notification-service keeps broad rights since it also drives the STOMP
# broker relay, which creates queues dynamically per WebSocket session. Leave both pairs
# empty to keep using the shared RABBITMQ_USER/PASSWORD account (correct for local dev).
RABBITMQ_BACKEND_USER=
RABBITMQ_BACKEND_PASSWORD=
RABBITMQ_NOTIFICATION_USER=
RABBITMQ_NOTIFICATION_PASSWORD=

# notification-service — shared secret notification-service sends when calling the
# backend's internal session-validation endpoint (WS single-session-lock check).
# Generate the same way as FILE_SERVICE_INTERNAL_API_KEY.
BACKEND_INTERNAL_API_KEY=

# Arno AI chatbot — Google Gemini free tier (gemini-2.0-flash). Get a key at
# https://aistudio.google.com/apikey. Leave GEMINI_API_KEY empty to fully disable the
# feature (no bot user, no auto-created chat, no welcome message).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepL API key — only used by wac/frontend `npm run i18n:translate` to generate the en/fr/de/es
# dictionaries from the Italian source. Free-plan keys end in ":fx" (routes to api-free.deepl.com).
# Never read by any running service.
DEEPL_API_KEY=

# Arno's avatar — public R2 URL, uploaded manually to the R2 bucket above at
# avatars/00000000-0000-0000-0000-000000000001/<filename>.
ARNO_AVATAR_URL=

# Observability — Grafana admin login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Production hardening — Grafana (:3000) and the RabbitMQ management UI (:15672) are
# bound to this IP instead of 0.0.0.0, so they're reachable over the Tailscale VPN but not
# the public internet. Get it on the production host with `tailscale ip -4`. Defaults to
# 127.0.0.1 (loopback-only) if left empty, which is correct for local dev.
TAILSCALE_IP=

# Observability — trace/log export targets. Defaults below match backend/api-gateway/
# file-service application.yml and are correct for local dev (services run on the host,
# Tempo/Loki reachable via localhost). deploy-prod.sh overrides these to container DNS
# names (http://wacchat-tempo:4318/v1/traces, http://wacchat-loki:3100/loki/api/v1/push)
# when running the 3 services as Docker containers — no need to set them here for prod.
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
LOKI_URL=http://localhost:3100/loki/api/v1/push
TRACING_SAMPLING_PROBABILITY=1.0
